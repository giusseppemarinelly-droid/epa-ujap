# Connection string de Postgres de Supabase.
# Usa el "Transaction pooler" (puerto 6543, con ?pgbouncer=true), no la conexión
# directa (db.xxx.supabase.co:5432): esa resuelve solo por IPv6 y falla en redes
# sin ruta IPv6 (p. ej. WSL). El "Session pooler" (5432) también puede ser
# rechazado según la IP de salida (VPN, etc.). Cópialo desde Project Settings >
# Database > Connection string > Transaction pooler.
# Si la contraseña tiene caracteres especiales, codifícalos en la URL
# (ej. $ -> %24, * -> %2A).
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Secreto para firmar los JWT. Genera uno con: openssl rand -base64 48
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

PORT=4000

# Dominio permitido para el registro. Temporal: hasta tener un remitente
# institucional, se usa Gmail y el código de verificación llega a esa
# bandeja. Cambiar a "ujap.edu.ve" cuando haya envío institucional real.
ALLOWED_EMAIL_DOMAIN="gmail.com"

# Cuenta de Gmail que manda el código de verificación por correo.
# GMAIL_APP_PASSWORD es una "contraseña de aplicación" de 16 caracteres
# (myaccount.google.com/apppasswords, requiere verificación en 2 pasos
# activada en esa cuenta), no la contraseña normal.
GMAIL_USER="tu-cuenta@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"
EMAIL_FROM="Epa <tu-cuenta@gmail.com>"
